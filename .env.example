# Template for .env. Copy to .env and fill in the values. Safe to commit.
# Loaded by dhis2_env.py. Real environment variables override these values.


# --- Nigeria NCD (production) ---------------------------------------------
# move_patients.py (source), cvh_redcap_to_dhis2.py (target),
# sync_patients.py (source)
NIGERIA_NCD_URL=
NIGERIA_NCD_USERNAME=
NIGERIA_NCD_PASSWORD=

# --- Sandbox 1 -----------------------------------------------------------
# NOT production. Target of sync_patients.py, which copies anonymised patients
# out of NIGERIA_NCD into it. Fill these in before the first sync run.
SANDBOX1_URL=
SANDBOX1_USERNAME=
SANDBOX1_PASSWORD=

# --- Egypt HTN/DM SANDBOX 3 ----------------------------------------------
# NOT production. This is the sandbox the demo cohort is generated into, and
# the scripts that write to it also purge tracker patients and aggregate
# values. Keep production credentials out of this prefix - add a separate
# EGYPT_PROD_* block if a production instance is ever needed.
#
# Used by: move_patients_egypt.py, rebuild_egypt_demo.py,
# purge_egypt_patients.py, purge_aggregate_values.py,
# fix_bmi35_boundary.py, fix_active_patient_filter.py
EGYPT_SANDBOX3_URL=
EGYPT_SANDBOX3_USERNAME=
EGYPT_SANDBOX3_PASSWORD=

# --- Egypt HTN/DM STAGING ------------------------------------------------
# Same metadata configuration as sandbox 3 (or should be - verify with
# `python preflight_target.py --target EGYPT_STAGING` before writing to it).
EGYPT_STAGING_URL=
EGYPT_STAGING_USERNAME=
EGYPT_STAGING_PASSWORD=

# --- Egypt HTN/DM PRODUCTION ---------------------------------------------
# REAL PATIENT DATA. The toolkit's purge and rebuild scripts delete tracker
# patients and aggregate values; pointed here they would destroy real records.
# They refuse to run against a target whose prefix or URL looks like
# production unless --allow-production is passed explicitly.
# Leave these blank unless you actually need them.
EGYPT_PROD_URL=
EGYPT_PROD_USERNAME=
EGYPT_PROD_PASSWORD=

# --- HTN/DM demo (move_patients.py target) --------------------------------
HTN_DM_DEMO_URL=
HTN_DM_DEMO_USERNAME=
HTN_DM_DEMO_PASSWORD=

# --- eIDSR / Zebra, Zambia (eidsr-*.py) ----------------------------------
EIDSR_URL=
EIDSR_USERNAME=
EIDSR_PASSWORD=

ZEBRA_URL=
ZEBRA_USERNAME=
ZEBRA_PASSWORD=

# --- Ecuador demo (add_diabetes.py) --------------------------------------
ECUADOR_DEMO_URL=
ECUADOR_DEMO_USERNAME=
ECUADOR_DEMO_PASSWORD=

# --- Epidemics sandbox (dhis2_risk_test.py) ------------------------------
SANDBOX_EPIDEMICS_URL=
SANDBOX_EPIDEMICS_USERNAME=
SANDBOX_EPIDEMICS_PASSWORD=

# --- Niger cleaning (get_datavalue_availability.py) ----------------------
NIGER_CLEANING_URL=
NIGER_CLEANING_USERNAME=
NIGER_CLEANING_PASSWORD=

# --- Senegal cleaning (get_datavalue_stats.py) ---------------------------
SENEGAL_CLEANING_URL=
SENEGAL_CLEANING_USERNAME=
SENEGAL_CLEANING_PASSWORD=

# --- Uganda HMIS (cumulative.py) -----------------------------------------
UGANDA_HMIS_URL=
UGANDA_HMIS_USERNAME=
UGANDA_HMIS_PASSWORD=

# --- BAO Systems Brussels testing (run_dq_analysis.py) -------------------
BRUSSELS_BAO_URL=
BRUSSELS_BAO_USERNAME=
BRUSSELS_BAO_PASSWORD=

# --- SNIS RDC (run_dq_analysis.py) ---------------------------------------
SNIS_RDC_URL=
SNIS_RDC_USERNAME=
SNIS_RDC_PASSWORD=

# --- DHIS2 public demo/dev servers (robot account) -----------------------
DHIS2_HMIS_DEV_URL=
DHIS2_HMIS_DEV_USERNAME=
DHIS2_HMIS_DEV_PASSWORD=

DHIS2_HMIS_STAGING_URL=
DHIS2_HMIS_STAGING_USERNAME=
DHIS2_HMIS_STAGING_PASSWORD=

# create_initial_dhis2_setup.py iterates over its own instance list, so it
# needs the account only. URL is unused but kept for a uniform prefix.
DHIS2_ROBOT_URL=
DHIS2_ROBOT_USERNAME=
DHIS2_ROBOT_PASSWORD=

# --- DHIS2 play / test servers (add_values.py, test.py) ------------------
DHIS2_TEST_REAL_URL=
DHIS2_TEST_REAL_USERNAME=
DHIS2_TEST_REAL_PASSWORD=

DHIS2_PLAY_URL=
DHIS2_PLAY_USERNAME=
DHIS2_PLAY_PASSWORD=

# --- Ethiopia EPHI staging (test.py report download) ---------------------
EPHI_STAGING_URL=
EPHI_STAGING_USERNAME=
EPHI_STAGING_PASSWORD=

# --- Metadata dev campaign / aggregate moves (move_agg_data.py) ----------
DHIS2_CAMPAIGN_URL=
DHIS2_CAMPAIGN_USERNAME=
DHIS2_CAMPAIGN_PASSWORD=

# --- Personal access token (stress_test.py) ------------------------------
# Staging:
DHIS2_API_TOKEN=
# Production (swap the two lines, or override DHIS2_API_TOKEN in the shell):
# DHIS2_API_TOKEN=

# --- thresholds_and_alerts.py --------------------------------------------
# DHIS2 server the alerting script reads from.
ALERTS_DHIS2_URL=
ALERTS_DHIS2_USERNAME=
ALERTS_DHIS2_PASSWORD=

# SMTP account used to send the alert emails (Gmail: use an app password).
ALERTS_SMTP_SERVER=
ALERTS_SMTP_PORT=
ALERTS_SMTP_SENDER=
ALERTS_SMTP_PASSWORD=

# --- DHIS2 out-of-the-box admin account (create_initial_dhis2_setup.py) --
DHIS2_DEFAULT_ADMIN_USERNAME=
DHIS2_DEFAULT_ADMIN_PASSWORD=

# --- Generic target used by populate_period_table.py --------------------
# The script's 4th CLI argument overrides DHIS2_TARGET_URL.
DHIS2_TARGET_URL=
DHIS2_TARGET_USERNAME=
DHIS2_TARGET_PASSWORD=
